          "rawSql": "SELECT if(Attributes['user.email'] != '', Attributes['user.email'], if(ResourceAttributes['user.email'] != '', ResourceAttributes['user.email'], Attributes['user.id'])) AS user, sum(Value) AS cost FROM otel.otel_metrics_sum WHERE MetricName = 'claude_code.cost.usage' AND AggregationTemporality = 1 AND ServiceName IN ('claude-code', 'claude-code-desktop') AND $__timeFilter(TimeUnix) AND ('${user}' = '__all__' OR if(Attributes['user.email'] != '', Attributes['user.email'], if(ResourceAttributes['user.email'] != '', ResourceAttributes['user.email'], Attributes['user.id'])) = '${user}') GROUP BY user ORDER BY cost DESC LIMIT 15"
