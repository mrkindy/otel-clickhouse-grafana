    {
      "type": "stat",
      "title": "Cache hit rate",
      "description": "Share of input tokens served from the prompt cache (cacheRead / (input + cacheRead + cacheCreation)).",
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "clickhouse"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "clickhouse"
          },
          "editorType": "sql",
          "format": 1,
          "queryType": "table",
          "rawSql": "SELECT sumIf(Value, Attributes['type'] = 'cacheRead') / nullIf(sumIf(Value, Attributes['type'] IN ('input', 'cacheRead', 'cacheCreation')), 0) FROM otel.otel_metrics_sum WHERE MetricName = 'claude_code.token.usage' AND AggregationTemporality = 1 AND ServiceName IN ('claude-code', 'claude-code-desktop') AND $__timeFilter(TimeUnix) AND ('${user}' = '__all__' OR if(Attributes['user.email'] != '', Attributes['user.email'], if(ResourceAttributes['user.email'] != '', ResourceAttributes['user.email'], Attributes['user.id'])) = '${user}')"
        }
