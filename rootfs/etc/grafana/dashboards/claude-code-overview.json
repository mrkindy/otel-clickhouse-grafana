    {
      "type": "table",
      "title": "Most expensive sessions",
      "description": "",
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "clickhouse"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "clickhouse"
          },
          "editorType": "sql",
          "format": 1,
          "queryType": "table",
          "rawSql": "SELECT SessionId AS session, any(if(UserEmail != '', UserEmail, UserId)) AS user, min(Timestamp) AS started, sumIf(toFloat64OrZero(LogAttributes['cost_usd']), Event = 'api_request') AS cost_usd, countIf(Event = 'user_prompt') AS prompts, countIf(Event = 'tool_result') AS tool_calls FROM otel.otel_logs WHERE ServiceName IN ('claude-code', 'claude-code-desktop') AND $__timeFilter(Timestamp) AND ('${user}' = '__all__' OR if(UserEmail != '', UserEmail, UserId) = '${user}') AND SessionId != '' GROUP BY SessionId ORDER BY cost_usd DESC LIMIT 10"
        }
      ],
      "options": {
        "showHeader": true,
        "cellHeight": "sm",
        "footer": {
          "show": false
        }
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto",
            "filterable": true
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "cost_usd"
            },
            "properties": [
              {
                "id": "unit",
                "value": "currencyUSD"
              },
              {
                "id": "decimals",
                "value": 2
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "session"
            },
            "properties": [
              {
                "id": "links",
                "value": [
                  {
                    "title": "Open session",
                    "url": "/d/claude-code-session-detail?var-session=${__value.raw}&${__url_time_range}"
                  }
                ]
              }
            ]
          }
        ]
      },
