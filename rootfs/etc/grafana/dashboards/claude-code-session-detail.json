          "editorType": "sql",
          "format": 1,
          "queryType": "table",
          "rawSql": "SELECT sumIf(toFloat64OrZero(LogAttributes['cost_usd']), Event = 'api_request') FROM otel.otel_logs WHERE ServiceName IN ('claude-code', 'claude-code-desktop') AND SessionId = '${session}'"
