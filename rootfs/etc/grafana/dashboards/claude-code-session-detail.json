          "editorType": "sql",
          "format": 1,
          "queryType": "table",
          "rawSql": "SELECT LogAttributes['tool_name'] AS tool, sum(toFloat64OrZero(LogAttributes['duration_ms'])) AS total_ms FROM otel.otel_logs WHERE ServiceName IN ('claude-code', 'claude-code-desktop') AND SessionId = '${session}' AND Event = 'tool_result' GROUP BY tool ORDER BY total_ms DESC"
        }
      ],
      "options": {
        "orientation": "horizontal",
        "showValue": "auto",
