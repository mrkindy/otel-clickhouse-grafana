          "rawSql": "SELECT if(anyIf(Repository, Repository != '') != '', anyIf(Repository, Repository != ''), '(no repository)') FROM otel.otel_logs WHERE ServiceName IN ('claude-code', 'claude-code-desktop') AND SessionId = '${session}'"
        }
