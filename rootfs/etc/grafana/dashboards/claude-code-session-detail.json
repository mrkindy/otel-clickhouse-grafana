{
  "uid": "claude-code-session-detail",
  "title": "Claude Code — Session Detail",
  "description": "The full timeline of one Claude Code session, grouped by prompt.",
  "tags": [
    "claude-code"
  ],
  "editable": false,
  "graphTooltip": 1,
  "schemaVersion": 41,
  "version": 1,
  "time": {
    "from": "now-30d",
    "to": "now"
  },
  "refresh": "1m",
  "timepicker": {},
  "timezone": "browser",
  "links": [
    {
      "title": "Claude Code",
      "type": "dashboards",
      "tags": [
        "claude-code"
      ],
      "asDropdown": false,
      "includeVars": true,
      "keepTime": true
    }
  ],
  "templating": {
    "list": [
      {
        "name": "session",
        "label": "Session",
        "type": "query",
        "datasource": {
          "type": "grafana-clickhouse-datasource",
          "uid": "clickhouse"
        },
        "query": "SELECT SessionId FROM otel.otel_logs WHERE ServiceName IN ('claude-code', 'claude-code-desktop') AND SessionId != '' AND $__timeFilter(Timestamp) GROUP BY SessionId ORDER BY max(Timestamp) DESC LIMIT 300",
        "includeAll": false,
        "multi": false,
        "refresh": 2,
        "sort": 0,
        "current": {},
        "options": []
      }
    ]
  },
  "annotations": {
