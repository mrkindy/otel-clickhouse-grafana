          "rawSql": "SELECT LogAttributes['model'] AS model, sum(toFloat64OrZero(LogAttributes['cost_usd'])) AS cost FROM otel.otel_logs WHERE ServiceName IN ('claude-code', 'claude-code-desktop') AND SessionId = '${session}' AND Event = 'api_request' GROUP BY model ORDER BY cost DESC"
