    {
      "type": "table",
      "title": "Prompts in this session",
      "description": "Grouped by prompt.id. prompt_text is only filled when developers enable OTEL_LOG_USER_PROMPTS=1.",
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "clickhouse"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "clickhouse"
          },
          "editorType": "sql",
          "format": 1,
          "queryType": "table",
          "rawSql": "SELECT PromptId AS prompt, min(Timestamp) AS started, dateDiff('millisecond', min(Timestamp), max(Timestamp)) / 1000 AS duration, nullIf(anyIf(LogAttributes['prompt'], Event = 'user_prompt'), '<REDACTED>') AS prompt_text, maxIf(toFloat64OrZero(LogAttributes['prompt_length']), Event = 'user_prompt') AS prompt_length, countIf(Event = 'api_request') AS api_calls, countIf(Event = 'tool_result') AS tool_calls, sumIf(toFloat64OrZero(LogAttributes['cost_usd']), Event = 'api_request') AS cost_usd, countIf(Event = 'api_error' OR (Event = 'tool_result' AND LogAttributes['success'] = 'false')) AS errors FROM otel.otel_logs WHERE ServiceName IN ('claude-code', 'claude-code-desktop') AND SessionId = '${session}' AND PromptId != '' GROUP BY PromptId ORDER BY started"
        }
      ],
      "options": {
        "showHeader": true,
        "cellHeight": "sm",
        "footer": {
          "show": false
        }
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto",
            "filterable": true
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "cost_usd"
            },
            "properties": [
              {
                "id": "unit",
                "value": "currencyUSD"
              },
              {
                "id": "decimals",
                "value": 3
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "duration"
            },
            "properties": [
              {
                "id": "unit",
                "value": "s"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "prompt"
            },
            "properties": [
              {
                "id": "custom.width",
                "value": 120
              }
            ]
          }
        ]
      },
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 24,
        "h": 9
      },
      "id": 9
    },
    {
      "type": "table",
      "title": "Timeline",
      "description": "Events of the session in order. Startup bookkeeping (hook/plugin registration, MCP connections that succeeded, settings resolution) is hidden.",
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "clickhouse"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "clickhouse"
          },
          "editorType": "sql",
          "format": 1,
          "queryType": "table",
          "rawSql": "SELECT Timestamp AS time, substring(PromptId, 1, 8) AS prompt, replaceOne(Event, 'claude_code.', '') AS event, LogAttributes['tool_name'] AS tool, LogAttributes['model'] AS model, if(LogAttributes['duration_ms'] != '', toFloat64OrZero(LogAttributes['duration_ms']), NULL) AS duration_ms, if(Event = 'api_request', toFloat64OrZero(LogAttributes['cost_usd']), NULL) AS cost_usd, multiIf(Event = 'tool_result', if(LogAttributes['success'] = 'true', 'ok', 'failed'), Event = 'tool_decision', LogAttributes['decision'], Event = 'api_error', LogAttributes['status_code'], '') AS status, multiIf(LogAttributes['error'] != '', LogAttributes['error'], Event = 'tool_decision', LogAttributes['source'], Event = 'api_request', concat(toString(toFloat64OrZero(LogAttributes['input_tokens']) + toFloat64OrZero(LogAttributes['cache_read_tokens']) + toFloat64OrZero(LogAttributes['cache_creation_tokens'])), ' in / ', LogAttributes['output_tokens'], ' out'), Event = 'user_prompt' AND LogAttributes['prompt'] != '<REDACTED>', LogAttributes['prompt'], Event = 'hook_execution_complete', LogAttributes['hook_event'], '') AS details FROM otel.otel_logs WHERE ServiceName IN ('claude-code', 'claude-code-desktop') AND SessionId = '${session}' AND Event NOT IN ('hook_registered', 'hook_execution_start', 'plugin_loaded', 'managed_settings_resolved', 'retention_sweep', 'feedback_survey') AND NOT (Event = 'mcp_server_connection' AND LogAttributes['error'] = '' AND LogAttributes['error_code'] = '') ORDER BY Timestamp, toUInt64OrZero(LogAttributes['event.sequence']) LIMIT 5000"
        }
      ],
      "options": {
        "showHeader": true,
        "cellHeight": "sm",
        "footer": {
          "show": false
        }
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto",
            "filterable": true
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "cost_usd"
            },
            "properties": [
              {
                "id": "unit",
                "value": "currencyUSD"
              },
              {
                "id": "decimals",
                "value": 4
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "duration_ms"
            },
            "properties": [
              {
                "id": "unit",
                "value": "ms"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "time"
            },
            "properties": [
              {
